{
  "manifest_version": 3,
  "name": "Auth State Sync",
  "version": "1.0.0",
  "description": "Extract active cookies, localStorage, and sessionStorage for Playwright headless injection.",
  "permissions": [
    "cookies",
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
